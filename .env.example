# Example environment file — copy to .env locally if needed.
# NEVER put real secret values here. Private keys/secrets are managed in
# Lovable Cloud's encrypted secret store (Project Settings → Secrets), not in git.

# Supabase / Lovable Cloud configuration (publishable values, injected by the platform)
VITE_SUPABASE_PROJECT_ID=your-project-id
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-anon-key
